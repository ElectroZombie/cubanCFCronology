---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAuthors } from '../../lib/content';
import { createPublicSupabaseClient } from '../../lib/supabase';
import { SITE } from '../../config/site';
import { PUBLIC_SUPABASE_ANON_KEY, PUBLIC_SUPABASE_URL } from 'astro:env/client';

const supabaseConfigured = Boolean(
  PUBLIC_SUPABASE_URL && PUBLIC_SUPABASE_ANON_KEY,
);
const authors = supabaseConfigured
  ? await getAuthors(createPublicSupabaseClient())
  : [];
---

<BaseLayout title="Autores" description={`Autores de la ciencia ficción y fantasía cubana — ${SITE.title}`}>
  <!-- Breadcrumbs -->
  <div class="panel p-4 mb-6 border-green-600/30">
    <nav aria-label="breadcrumb">
      <ol class="flex flex-wrap gap-2 text-sm text-bone-300">
        <li><a href="/" class="nav-link">Inicio</a></li>
        <li><span class="text-bone-400">Autores</span></li>
      </ol>
    </nav>
  </div>

  <section class="space-y-8">
    <header class="border-b border-green-600/40 pb-6">
      <p class="font-mono text-xs uppercase text-green-500">
        Archivo de autores
      </p>
      <h1 class="mt-2 font-mono text-3xl text-bone-50">Autores</h1>
      <p class="mt-3 max-w-2xl text-bone-300">
        Perfiles de quienes han contribuido a la ciencia ficción y la fantasía
        cubanas.
      </p>
    </header>

    {!supabaseConfigured ? (
      <section class="panel p-8 border-green-600/30">
        <h2 class="font-mono text-xl text-bone-50 mb-4">
          Conexión pendiente
        </h2>
        <p class="text-bone-300 mb-4">
          El archivo de autores estará disponible cuando se configure la
          conexión con la base de datos de Supabase.
        </p>
        <a
          href="/"
          class="btn-ship inline-block"
        >
          Volver al inicio
        </a>
      </section>
    ) : authors.length === 0 ? (
      <section class="panel p-8 border-green-600/30">
        <h2 class="font-mono text-xl text-bone-50 mb-4">
          Sin perfiles registrados
        </h2>
        <p class="text-bone-300 mb-4">
          Todavía no hay perfiles de autores en el registro. Los datos se
          poblarán desde la fuente Korad una vez que la base de datos esté
          configurada.
        </p>
        <a
          href="/"
          class="btn-ship inline-block"
        >
          Volver al inicio
        </a>
      </section>
    ) : (
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {authors.map((author) => (
          <li class="panel p-5">
            <h2 class="font-mono text-lg text-bone-50">{author.fullname}</h2>
            {author.pseudonyme && (
              <p class="mt-1 text-sm text-green-400">{author.pseudonyme}</p>
            )}
            {author.biography && (
              <p class="mt-3 text-sm text-bone-300">{author.biography}</p>
            )}
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>