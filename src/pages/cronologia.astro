---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedChronicles } from '../lib/content';
import { createPublicSupabaseClient } from '../lib/supabase';
import { SITE } from '../config/site';
import { PUBLIC_SUPABASE_ANON_KEY, PUBLIC_SUPABASE_URL } from 'astro:env/client';

const supabaseConfigured = Boolean(
  PUBLIC_SUPABASE_URL && PUBLIC_SUPABASE_ANON_KEY,
);
const chronicles = supabaseConfigured
  ? await getPublishedChronicles(createPublicSupabaseClient())
  : [];
---

<BaseLayout title="Cronología" description="Cronología de obras publicadas de ciencia ficción y fantasía cubanas.">
  <!-- Breadcrumbs -->
  <div class="panel p-4 mb-6 border-green-600/30">
    <nav aria-label="breadcrumb">
      <ol class="flex flex-wrap gap-2 text-sm text-bone-300">
        <li><a href="/" class="nav-link">Inicio</a></li>
        <li><span class="text-bone-400">Cronología</span></li>
      </ol>
    </nav>
  </div>

  <section class="space-y-8">
    <header class="border-b border-green-600/40 pb-6">
      <p class="font-mono text-xs uppercase text-green-500">
        Registro histórico
      </p>
      <h1 class="mt-2 font-mono text-3xl text-bone-50">Cronología</h1>
      <p class="mt-3 max-w-2xl text-bone-300">
        Obras de tipo crónica ordenadas por año de publicación.
      </p>
    </header>

    {!supabaseConfigured ? (
      <section class="panel p-8 border-green-600/30">
        <h2 class="font-mono text-xl text-bone-50 mb-4">
          Conexión pendiente
        </h2>
        <p class="text-bone-300 mb-4">
          La cronología estará disponible cuando se configure la conexión con la
          base de datos de Supabase.
        </p>
        <a href="/" class="btn-ship inline-block">
          Volver al inicio
        </a>
      </section>
    ) : chronicles.length === 0 ? (
      <section class="panel p-8 border-green-600/30">
        <h2 class="font-mono text-xl text-bone-50 mb-4">
          Sin crónicas registradas
        </h2>
        <p class="text-bone-300 mb-4">
          Todavía no hay crónicas publicadas en el registro. Los datos se
          poblarán desde la fuente Korad una vez que la base de datos esté
          configurada.
        </p>
        <a href="/" class="btn-ship inline-block">
          Volver al inicio
        </a>
      </section>
    ) : (
      <ol class="divide-y divide-green-600/25 border-l border-green-600/50 pl-5">
        {chronicles.map((work) => (
          <li class="relative py-5 pl-2">
            <time
              class="font-mono text-sm text-green-400"
              datetime={`${work.year}`}
            >
              {work.year}
            </time>
            <h2 class="mt-1 font-mono text-lg text-bone-50">
              <a href={`/obras/${work.slug}`}>{work.title}</a>
            </h2>
            {work.link && (
              <a
                href={work.link}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-1 inline-block text-sm"
              >
                Fuente
              </a>
            )}
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>