---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title="Acerca de CubanCFCronology"
  description={`Sobre ${SITE.title}: cronología de la ciencia ficción cubana contemporánea (1999-2025)`}
>
  <!-- Breadcrumbs -->
  <div class="panel p-4 mb-6 border-green-600/30">
    <nav aria-label="breadcrumb">
      <ol class="flex flex-wrap gap-2 text-sm text-bone-300">
        <li>
          <a href="/" class="nav-link">
            Inicio
          </a>
        </li>
        <li>
          <span class="text-bone-400">Acerca</span>
        </li>
      </ol>
    </nav>
  </div>

  <section class="space-y-8 max-w-3xl mx-auto">
    <header class="border-b border-green-600/40 pb-6">
      <p class="font-mono text-xs uppercase text-green-500">
        Acerca del proyecto
      </p>
      <h1 class="mt-2 font-mono text-3xl text-bone-50">
        Acerca de CubanCFCronology
      </h1>
    </header>

    <article class="space-y-6">
      <h2 class="font-mono text-xl text-bone-50">¿Qué es CubanCFCronology?</h2>
      <p class="text-bone-300 leading-relaxed">
        CubanCFCronology es un registro de obras, autores y editoriales de la
        ciencia ficción y la fantasía cubana contemporánea (1999-2025). Recopila
        datos bibliográficos, biografías de autores y cronología de
        publicaciones para preservar y difundir el género en Cuba y su diáspora.
      </p>

      <h2 class="font-mono text-xl text-bone-50">Fuentes</h2>
      <p class="text-bone-300 leading-relaxed">
        Los datos se extraen principalmente de la <strong>Revista Korad</strong>
        , especialmente el taller "Espacio Abierto" y su artículo "Cronología de
        la ciencia ficción cubana contemporánea (1999-2025)". Cada obra
        registrada incluye un enlace a su fuente original.
      </p>

      <h2 class="font-mono text-xl text-bone-50">Licencia</h2>
      <p class="text-bone-300 leading-relaxed">
        El contenido editorial está disponible bajo
        <a href="/licencia" class="text-green-500 hover:text-green-400">
          CC BY-SA 4.0
        </a>
        . El código fuente está bajo
        <a
          href="https://opensource.org/licenses/MIT"
          class="text-green-500 hover:text-green-400"
        >
          MIT License
        </a>
        .
      </p>

      <h2 class="font-mono text-xl text-bone-50">Contacto</h2>
      <p class="text-bone-300 leading-relaxed">
        Para correcciones, sugerencias o colaboración, escríbenos a través de
        nuestros canales de contacto.
      </p>
    </article>

    <aside class="panel p-6 border-green-600/50">
      <h3 class="font-mono text-lg text-bone-50 mb-4">
        Estadísticas del registro
      </h3>
      <ul class="space-y-3 text-bone-300">
        <li class="flex justify-between">
          <span>Obras catalogadas</span>
          <span class="font-mono text-bone-50">143</span>
        </li>
        <li class="flex justify-between">
          <span>Autores registrados</span>
          <span class="font-mono text-bone-50">52</span>
        </li>
        <li class="flex justify-between">
          <span>Editoriales</span>
          <span class="font-mono text-bone-50">34</span>
        </li>
      </ul>
    </aside>
  </section>
</BaseLayout>
