---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createPublicSupabaseClient } from '../../lib/supabase';
import { AuthorSchema } from '../../lib/zod-schemas';
import { PUBLIC_SUPABASE_KEY, PUBLIC_SUPABASE_URL } from 'astro:env/client';

const supabaseConfigured = Boolean(PUBLIC_SUPABASE_URL && PUBLIC_SUPABASE_KEY);

interface AuthorRow {
  id: string;
  fullname: string;
  pseudonyme: string | null;
  slug: string;
  owner_user_id: string | null;
}

/**
 * Read every author row.
 *
 * This runs at build time, so the output is a snapshot. The service role key is
 * deliberately not used here: the site build must never depend on privileged
 * credentials. `owner_user_id` is only readable with elevated rights, so this
 * page reports link status from what the public client can see.
 */
async function getAllAuthors(): Promise<AuthorRow[]> {
  const client = createPublicSupabaseClient();
  const { data, error } = await client
    .from('authors')
    .select('id, fullname, pseudonyme, slug, owner_user_id')
    .order('fullname');

  if (error) throw new Error(error.message);

  // `owner_user_id` is filtered out by RLS for non-owners; validate the rest.
  return AuthorSchema.array()
    .parse(data ?? [])
    .map(({ id, fullname, pseudonyme, slug }) => ({
      id,
      fullname,
      pseudonyme,
      slug,
      owner_user_id: null,
    }));
}

let authors: AuthorRow[] = [];
let serverError: string | null = null;

if (supabaseConfigured) {
  try {
    authors = await getAllAuthors();
  } catch (error) {
    serverError = error instanceof Error ? error.message : String(error);
  }
}
---

<BaseLayout
  title="Panel de administración"
  description="Resumen del registro de autores — CubanCFCronology"
>
  <div class="panel p-4 mb-6 border-green-600/30">
    <nav aria-label="breadcrumb">
      <ol class="flex flex-wrap gap-2 text-sm text-bone-300">
        <li>
          <a href="/" class="nav-link">
            Inicio
          </a>
        </li>
        <li>
          <span class="text-bone-400">Administración</span>
        </li>
      </ol>
    </nav>
  </div>

  <section class="max-w-4xl mx-auto space-y-8">
    <header class="border-b border-green-600/40 pb-6">
      <p class="font-mono text-xs uppercase text-green-500">
        Panel de administración
      </p>
      <h1 class="mt-2 font-mono text-3xl text-bone-50">Administración</h1>
      <p class="mt-3 max-w-2xl text-bone-300">
        Resumen de solo lectura del registro de autores. Las altas, ediciones y
        vinculaciones de cuentas se hacen en Supabase Studio con privilegios de
        administrador.
      </p>
    </header>

    {!supabaseConfigured ? (
      <section class="panel p-8 border-green-600/30">
        <h2 class="font-mono text-xl text-bone-50 mb-4">Conexión pendiente</h2>
        <p class="text-bone-300 mb-6">
          El panel estará disponible cuando se configuren las variables de
          entorno de Supabase.
        </p>
        <a href="/" class="btn-ship inline-block">
          Volver al inicio
        </a>
      </section>
    ) : serverError ? (
      <section class="panel p-8 border-green-600/30">
        <h2 class="font-mono text-xl text-bone-50 mb-4">
          Error al cargar datos
        </h2>
        <p class="text-bone-300 mb-4">{serverError}</p>
        <a href="/" class="btn-ship inline-block">
          Volver al inicio
        </a>
      </section>
    ) : (
      <>
        <div class="panel p-6 border-green-600/50">
          <h2 class="font-mono text-lg text-bone-50 mb-4">
            Cómo administrar el registro
          </h2>
          <ol class="space-y-3 text-bone-300 leading-relaxed">
            <li>
              <strong class="text-bone-50">1. Crear un autor.</strong> En
              Supabase Studio, tabla <code class="text-green-400">authors</code>
              : inserta <code class="text-green-400">fullname</code>,
              <code class="text-green-400">slug</code> y
              <code class="text-green-400">biography</code>.
            </li>
            <li>
              <strong class="text-bone-50">2. Vincular una cuenta.</strong>
              Asigna <code class="text-green-400">owner_user_id</code> al
              <code class="text-green-400">id</code> del usuario de Auth. Solo
              los administradores pueden cambiar esta columna.
            </li>
            <li>
              <strong class="text-bone-50">3. Publicar.</strong> El autor activa{' '}
              <code class="text-green-400">is_published</code> en sus obras, o
              un administrador lo hace por él.
            </li>
            <li>
              <strong class="text-bone-50">4. Reconstruir.</strong> El webhook
              de Supabase dispara un redespliegue; el sitio estático se regenera
              con los datos nuevos.
            </li>
          </ol>
        </div>

        <div class="panel p-8 border-green-600/50">
          <div class="flex flex-wrap items-baseline justify-between gap-3 mb-4">
            <h2 class="font-mono text-xl text-bone-50">Autores registrados</h2>
            <span class="badge">{authors.length} en total</span>
          </div>

          {authors.length === 0 ? (
            <p class="text-bone-300">No hay autores registrados todavía.</p>
          ) : (
            <ul class="divide-y divide-green-600/25">
              {authors.map((author) => (
                <li class="py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                  <div>
                    <a
                      href={`/autores/${author.slug}`}
                      class="font-mono text-bone-50 hover:text-green-500"
                    >
                      {author.fullname}
                    </a>
                    {author.pseudonyme && (
                      <span class="ml-2 text-xs text-green-400">
                        ({author.pseudonyme})
                      </span>
                    )}
                    <p class="text-xs text-bone-400 mt-1">
                      Slug: {author.slug}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </div>
      </>
    )}
  </section>
</BaseLayout>
