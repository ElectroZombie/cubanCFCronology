{
  "name": "cubanCFCronology",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint \"src/**/*.{ts,astro}\" astro.config.mjs eslint.config.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" astro.config.mjs eslint.config.mjs package.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" astro.config.mjs eslint.config.mjs package.json .prettierrc.json",
    "db:seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "astro": "7.4.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@astrojs/cloudflare": "^14.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "cookie": "^2.0.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
