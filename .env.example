# Supabase (público — expuesto al navegador)
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo para scripts locales/offline; nunca se usa en el cliente ni en rutas web
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Cloudflare Deploy Hook (solo servidor; nunca exponer al navegador)
CLOUDFLARE_DEPLOY_HOOK=https://api.cloudflare.com/client/v4/accounts/TU_CUENTA/pages/projects/TU_PROYECTO/deployments/hook

# Site
PUBLIC_SITE_URL=https://cubancfcronology.com
