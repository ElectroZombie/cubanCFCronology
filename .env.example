# Supabase environment variables example
# Copy to .env and fill in actual values before running the project.
# .env is gitignored — do not commit real values.

# Public variables — exposed to client via astro:env/client
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, never reaches the client!
# Used for: offline seeding, db pushes, admin operations
# WARNING: This gives full database access. Keep secret!
SUPABASE_SERVICE_ROLE_KEY=