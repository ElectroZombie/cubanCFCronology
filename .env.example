# Supabase environment variables
# Copy to .env and fill in actual values before running the project.
# .env is gitignored — do not commit real values.

# ============================================================
# PUBLIC VARIABLES (exposed to client via astro:env/client)
# Safe to commit .env.example with placeholder values
# ============================================================

# Your Supabase project URL
PUBLIC_SUPABASE_URL=

# Anonymous public key
PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# SERVER-SIDE VARIABLES (astro:env/server)
# NOT for client-side use — keep secret!
# ============================================================

# Service Role Key
# ⚠️ Gives full database access — keep secret!
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# DATABASE AUTHENTICATION
# ============================================================

# Project Database Password
# Password for direct PostgreSQL connections
PROJECT_DATABASE_PASSWORD=

# ============================================================
# ADDITIONAL SETTINGS
# ============================================================

# Realtime, storage, etc. — usually not needed manually